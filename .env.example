# ==============================================================================
# VOID Search - Environment Variable Configuration
# ==============================================================================
# IMPORTANT:
# - NEVER commit real secrets or credentials to source control.
# - SERVER-ONLY variables must NEVER be prefixed with VITE_.
# - Vercel Production: Add SERVER-ONLY variables in Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES (Private - Never Expose to Browser)
# ------------------------------------------------------------------------------
# Required for: Local development & Vercel serverless API functions (/api/search, /api/autocomplete)
# Purpose: Authenticates trusted server functions to the Aiven OpenSearch cluster.

OPENSEARCH_URL=https://your-opensearch-cluster.aivencloud.com:12170
OPENSEARCH_USER=avnadmin
OPENSEARCH_PASSWORD=your_aiven_opensearch_password_here
OPENSEARCH_INDEX=indexed_pages

# Google Gemini API Key (Server-side AI Overview only - Never prefix with VITE_)
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE ENVIRONMENT VARIABLES (Public - Safe for Browser Bundle)
# ------------------------------------------------------------------------------
# Required for: Frontend client bundle (prefixed with VITE_ to be bundled by Vite)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
